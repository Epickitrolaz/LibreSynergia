# ==============================================================================
# Librus Synergia Client Credentials Template
# Copy this file to .env.local for local testing and debugging.
# NEVER commit real credentials to git!
# ==============================================================================

# Option A: Portal Rodzina (Konto LIBRUS) - Recommended for Multi-Child Accounts
LIBRUS_PORTAL_EMAIL=parent@example.com
LIBRUS_PORTAL_PASSWORD=your_portal_password

# Option B: Direct School-Issued Account (Synergia Gateway API 2.0)
# Note: Gateway login is numeric or alphanumeric (e.g. 1234567 or 1234567u), NOT an email address.
LIBRUS_GATEWAY_LOGIN=1234567
LIBRUS_GATEWAY_PASSWORD=your_gateway_password

# Optional: Default child selector (ID or login) for multi-child Portal accounts
LIBRUS_CHILD=1234567u

# Network timeouts (in milliseconds)
LIBRUS_TIMEOUT_MS=30000
